# Headscale Admin AE - Docker 配置模板
# 此文件由 entrypoint.sh 在容器启动时通过 envsubst 渲染为 config.yaml
# 所有 ${VAR} 占位符会被替换为环境变量的实际值

server_url: ${HEADSCALE_SERVER_URL}

listen_addr: 0.0.0.0:8080

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

scaleforge:
  socket: /var/run/scaleforge/control/api.sock
  socket_permission: "0660"
  backend_socket: /var/run/scaleforge/client/api.sock
  internal_auth_key_file: /run/secrets/scaleforge_internal_auth_key
  trust_proxy: ${HEADSCALE_TRUST_PROXY}
  trusted_proxy_cidrs: ${HEADSCALE_TRUSTED_PROXY_CIDRS}
  max_nodes_per_account: ${SCALEFORGE_MAX_NODES_PER_ACCOUNT}
  bootstrap_username: ${SCALEFORGE_BOOTSTRAP_USERNAME}
  bootstrap_password_file: /run/secrets/scaleforge_bootstrap_password

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: headscale
    region_name: Headscale Embedded DERP
    stun_listen_addr: 0.0.0.0:3478
    domain: ${DERP_DOMAIN}
    private: true
    verify_clients: true
    private_key_path: /var/lib/headscale/derp.key
  urls: []
  auto_update_enabled: false

database:
  type: postgres
  postgres:
    host: ${DB_HOST}
    port: ${DB_PORT}
    name: ${DB_NAME}
    user: ${DB_USER}
    pass: ${DB_PASS}
    ssl: false
    max_open_conns: 10
    max_idle_conns: 10
    conn_max_idle_time_secs: 3600

dns:
  magic_dns: ${HEADSCALE_MAGIC_DNS}
  base_domain: ${HEADSCALE_DNS_DOMAIN}
  override_local_dns: ${HEADSCALE_DNS_OVERRIDE_LOCAL}
  nameservers:
    global:
${HEADSCALE_DNS_GLOBAL_YAML}
${HEADSCALE_DNS_SEARCH_YAML}

log:
  level: ${HEADSCALE_LOG_LEVEL}
  format: text

policy:
  mode: database
